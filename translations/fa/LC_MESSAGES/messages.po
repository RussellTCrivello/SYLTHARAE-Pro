msgstr ""
"این برچسب‌ها منحصراً به رده‌بندی تحلیلگر (دستی) تعلق دارند و هرگز با دسته‌بندی‌های "
"هوشمند به اشتراک گذاشته نمی‌شوند."

msgid ""
"Every categorization action with analyst, timestamp, category, originating query and "
"affected files."
